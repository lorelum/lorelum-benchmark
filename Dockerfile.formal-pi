FROM node:22.19.0-bookworm-slim

RUN apt-get update && apt-get install --yes --no-install-recommends ca-certificates curl && rm -rf /var/lib/apt/lists/* && \
    npm install --global bun@1.3.11

WORKDIR /opt/formal-pi
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile && ln -s /opt/formal-pi/node_modules/.bin/pi /usr/local/bin/pi && \
    test "$(bun --version)" = "1.3.11" && \
    test "$(node --version)" = "v22.19.0" && \
    command -v pi >/dev/null && \
    grep -q '"version": "0.80.10"' node_modules/@earendil-works/pi-coding-agent/package.json

USER 65532:65532
ENTRYPOINT ["pi"]
