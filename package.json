{
  "name": "lorelum-benchmark",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "bun run src/benchmark/validate.ts && bun run src/benchmark/snapshot.ts",
    "snapshot": "bun run src/benchmark/snapshot.ts --write",
    "evaluate": "bun run src/benchmark/evaluate.ts",
    "pi": "bun run src/benchmark/runner/pi/v2/execute.ts",
    "pi:coordinate": "bun run src/benchmark/runner/pi/v2/coordinator.ts",
    "pi:requests": "bun run src/benchmark/runner/pi/request-generator.ts",
    "exploratory:practice": "bun run src/benchmark/exploratory-practice-effectiveness.ts",
    "calibrate:rules": "bun run src/benchmark/runner/pi/v2/calibrate-rules.ts",
    "pi:v1": "bun run src/benchmark/runner/pi/v1/execute.ts",
    "test:pi:v2": "bun test src/benchmark/runner/pi/v2",
    "test:sandbox": "bun run src/benchmark/runner/pi/v2/sandbox-preflight.ts",
    "test:local-sandbox": "bun run src/benchmark/runner/pi/v2/local-sandbox-preflight.ts",
    "test:fixtures": "bun run src/benchmark/fixtures.ts",
    "test:react-runtime": "bun --conditions=react-server test incubator/react-skill-comparison/react-server-runtime/react-cache-runtime.test.ts && bun --conditions=react-server test incubator/react-skill-comparison/react-server-runtime/react-rsc-serialization-runtime.test.ts",
    "test:exploratory:practice": "bun test src/benchmark/exploratory-practice-effectiveness.test.ts",
    "test:react-client-runtime": "bun test incubator/react-skill-comparison/react-server-runtime/react-client-runtime.test.ts",
    "test:realistic-repo": "bun test incubator/realistic-react-repo/v1/private/dashboard-rsc/evaluator/evaluate.test.ts && bun run incubator/realistic-react-repo/v1/private/dashboard-rsc/evaluator/verify-baseline.ts",
    "test:contracts": "bun test src/benchmark/validate.test.ts src/benchmark/evaluator/v2/harness.test.ts src/benchmark/runner/pi/v2 src/benchmark/runner/pi/request-generator.test.ts && bun run test:react-runtime && bun run test:react-client-runtime"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10"
  }
}
