{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judge-autonomous-pack-plan-v1.schema.json",
  "title": "Interactive Judge Pack diagnostic plan v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "adapterSha256", "caseSha256", "task", "taskIdentities", "judgeEnvironmentSha256", "judgeCommit", "terminalSha256", "loreSupportSha256", "runtime", "loreReleaseSha256", "model", "embedding", "packSha256", "indexes", "verifierImage", "order", "budget"],
  "properties": {
    "schema": { "const": "judge-autonomous-pack-plan/v1" },
    "adapterSha256": { "$ref": "#/$defs/digest" },
    "caseSha256": { "$ref": "#/$defs/digest" },
    "task": { "type": "string", "minLength": 1 },
    "taskIdentities": {
      "type": "object", "additionalProperties": false,
      "required": ["declaration_sha256", "task_sha256", "starter_sha256", "input_sha256", "evaluator_sha256", "calibration_sha256"],
      "properties": {
        "declaration_sha256": { "$ref": "#/$defs/digest" }, "task_sha256": { "$ref": "#/$defs/digest" },
        "starter_sha256": { "$ref": "#/$defs/digest" }, "input_sha256": { "$ref": "#/$defs/digest" },
        "evaluator_sha256": { "$ref": "#/$defs/digest" }, "calibration_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "judgeEnvironmentSha256": { "$ref": "#/$defs/digest" },
    "judgeCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "terminalSha256": { "$ref": "#/$defs/digest" }, "loreSupportSha256": { "$ref": "#/$defs/digest" },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["platform", "architecture", "kernel", "nodeVersion", "nodeSha256", "bubblewrap"],
      "properties": { "platform": { "const": "linux" }, "architecture": { "const": "x64" }, "kernel": { "type": "string", "minLength": 1 }, "nodeVersion": { "type": "string", "pattern": "^22\\." }, "nodeSha256": { "$ref": "#/$defs/digest" }, "bubblewrap": { "type": "string", "minLength": 1 } }
    },
    "loreReleaseSha256": { "$ref": "#/$defs/digest" },
    "model": { "type": "object", "additionalProperties": false, "required": ["provider", "name", "endpoint"], "properties": { "provider": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "endpoint": { "type": "string", "minLength": 1 } } },
    "embedding": { "type": "object", "additionalProperties": false, "required": ["modelSha256", "profile", "encoding"], "properties": { "modelSha256": { "$ref": "#/$defs/digest" }, "profile": { "$ref": "#/$defs/digest" }, "encoding": { "$ref": "#/$defs/digest" } } },
    "packSha256": { "$ref": "#/$defs/digest" },
    "indexes": { "type": "object", "additionalProperties": false, "required": ["empty", "installed", "emptyMetadata", "installedMetadata"], "properties": { "empty": { "$ref": "#/$defs/digest" }, "installed": { "$ref": "#/$defs/digest" }, "emptyMetadata": { "$ref": "#/$defs/digest" }, "installedMetadata": { "$ref": "#/$defs/digest" } } },
    "verifierImage": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "order": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["empty-store", "pack-installed"] } },
    "budget": { "$ref": "judge-autonomous-pack-case-v1.schema.json#/properties/budget" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
