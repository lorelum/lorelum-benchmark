{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lorelum evaluator result v2",
  "type": "object",
  "required": ["schema_version", "evaluator_version", "semantic", "quality"],
  "properties": {
    "schema_version": { "const": "evaluator-result/v2" },
    "evaluator_version": { "const": 2 },
    "semantic": {
      "type": "object",
      "required": ["passed", "checks"],
      "properties": {
        "passed": { "type": "boolean" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "passed": { "type": "boolean" },
              "failure_reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["score", "probes"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "probes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "points", "max_points"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "points": { "type": "integer", "minimum": 0, "maximum": 100 },
              "max_points": { "type": "integer", "minimum": 1, "maximum": 100 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "semantic": { "properties": { "passed": { "const": false } } } } },
      "then": { "properties": { "quality": { "properties": { "score": { "const": 0 }, "probes": { "maxItems": 0 } } } } }
    }
  ],
  "additionalProperties": false
}
