{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lorelum evaluator result v2",
  "$comment": "Cross-item ID uniqueness and score totals are enforced by assertEvaluatorResultV2 because JSON Schema cannot express those invariants.",
  "type": "object",
  "required": ["schema_version", "evaluator_version", "semantic", "quality"],
  "properties": {
    "schema_version": { "const": "evaluator-result/v2" },
    "evaluator_version": { "const": 2 },
    "semantic": {
      "type": "object",
      "required": ["passed", "checks"],
      "properties": {
        "passed": { "type": "boolean" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "passed"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "passed": { "type": "boolean" },
              "failure_reason": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": { "properties": { "passed": { "const": true } }, "required": ["passed"] },
                "then": {
                  "not": {
                    "properties": { "failure_reason": {} },
                    "required": ["failure_reason"]
                  }
                },
                "else": {
                  "properties": { "failure_reason": { "type": "string", "minLength": 1 } },
                  "required": ["failure_reason"]
                }
              }
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["score", "probes"],
      "properties": {
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "probes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "points", "max_points"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "points": { "type": "integer", "minimum": 0, "maximum": 100 },
              "max_points": { "type": "integer", "minimum": 1, "maximum": 100 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "semantic": {
            "type": "object",
            "properties": { "passed": { "const": true } },
            "required": ["passed"]
          }
        },
        "required": ["semantic"]
      },
      "then": {
        "properties": {
          "semantic": {
            "type": "object",
            "properties": {
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "passed": { "const": true } },
                  "required": ["passed"]
                }
              }
            },
            "required": ["checks"]
          },
          "quality": {
            "type": "object",
            "properties": { "probes": { "type": "array", "minItems": 1 } },
            "required": ["probes"]
          }
        }
      },
      "else": {
        "properties": {
          "semantic": {
            "type": "object",
            "properties": {
              "checks": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": { "passed": { "const": false } },
                  "required": ["passed"]
                },
                "minContains": 1
              }
            },
            "required": ["checks"]
          },
          "quality": {
            "type": "object",
            "properties": {
              "score": { "const": 0 },
              "probes": { "type": "array", "maxItems": 0 }
            },
            "required": ["score", "probes"]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
