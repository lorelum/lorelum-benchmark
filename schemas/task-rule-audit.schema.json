{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lorelum private task rule audit",
  "type": "object",
  "required": ["schema_version", "task_id", "treatment", "required_rules"],
  "properties": {
    "schema_version": { "const": "task-rule-audit/v1" },
    "task_id": { "type": "string", "pattern": "^[a-z0-9-]+-v[1-9][0-9]*$" },
    "treatment": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" }
      },
      "additionalProperties": false
    },
    "required_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+\\.md$" }
    }
  },
  "additionalProperties": false
}
