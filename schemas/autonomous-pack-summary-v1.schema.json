{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autonomous-pack-summary-v1.schema.json",
  "title": "Autonomous Pack experiment summary v1 (not a formal record)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "plan_id", "plan_sha256", "run_kind", "planned_runs", "conditions", "pairs", "uncertainty", "runs"],
  "properties": {
    "schema_version": { "const": "autonomous-pack-summary/v1" },
    "plan_id": { "type": "string", "minLength": 1 },
    "plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "run_kind": { "enum": ["pilot", "official"] },
    "planned_runs": { "$ref": "#/$defs/count" },
    "conditions": {
      "type": "object", "additionalProperties": false, "required": ["empty-store", "pack-installed"],
      "properties": { "empty-store": { "$ref": "#/$defs/condition" }, "pack-installed": { "$ref": "#/$defs/condition" } }
    },
    "pairs": {
      "type": "object", "additionalProperties": false,
      "required": ["planned", "eligible", "semantic_comparable", "pack_only_pass", "empty_only_pass", "both_pass", "both_fail"],
      "properties": {
        "planned": { "$ref": "#/$defs/count" }, "eligible": { "$ref": "#/$defs/count" }, "semantic_comparable": { "$ref": "#/$defs/count" },
        "pack_only_pass": { "$ref": "#/$defs/count" }, "empty_only_pass": { "$ref": "#/$defs/count" }, "both_pass": { "$ref": "#/$defs/count" }, "both_fail": { "$ref": "#/$defs/count" }
      }
    },
    "uncertainty": { "const": "not-estimated" },
    "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "counts": { "type": "object", "additionalProperties": { "$ref": "#/$defs/count" } },
    "measurement": { "type": "object", "additionalProperties": false, "required": ["available", "sum"], "properties": { "available": { "$ref": "#/$defs/count" }, "sum": { "type": "number", "minimum": 0 } } },
    "token_measurement": { "type": "object", "additionalProperties": false, "required": ["available", "sum"], "properties": { "available": { "$ref": "#/$defs/count" }, "sum": { "$ref": "#/$defs/count" } } },
    "quality_probe": {
      "type": "object", "additionalProperties": false, "required": ["id", "status", "points", "max_points"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["observed", "not-observed", "indeterminate", "not-run", "judge-unavailable"] },
        "points": { "type": ["number", "null"], "minimum": 0 },
        "max_points": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["planned", "observed", "missing", "eligible", "health", "semantic", "quality", "eligible_semantic", "eligible_quality", "query", "get_success", "get_failed", "get_indeterminate", "duration_ms", "cost_usd", "input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "planned": { "$ref": "#/$defs/count" }, "observed": { "$ref": "#/$defs/count" }, "missing": { "$ref": "#/$defs/count" }, "eligible": { "$ref": "#/$defs/count" },
        "health": { "$ref": "#/$defs/counts" }, "semantic": { "$ref": "#/$defs/counts" }, "quality": { "$ref": "#/$defs/counts" }, "query": { "$ref": "#/$defs/counts" },
        "eligible_semantic": { "$ref": "#/$defs/counts" }, "eligible_quality": { "$ref": "#/$defs/counts" },
        "get_success": { "$ref": "#/$defs/count" }, "get_failed": { "$ref": "#/$defs/count" }, "get_indeterminate": { "$ref": "#/$defs/count" },
        "duration_ms": { "$ref": "#/$defs/measurement" }, "cost_usd": { "$ref": "#/$defs/measurement" },
        "input_tokens": { "$ref": "#/$defs/token_measurement" }, "output_tokens": { "$ref": "#/$defs/token_measurement" }, "total_tokens": { "$ref": "#/$defs/token_measurement" }
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["pair_id", "task_id", "repetition", "condition", "ordinal", "input_sha256", "common_sha256", "status", "reasons"],
      "properties": {
        "pair_id": { "$ref": "#/$defs/digest" }, "task_id": { "type": "string", "minLength": 1 }, "repetition": { "$ref": "#/$defs/count" },
        "condition": { "enum": ["empty-store", "pack-installed"] }, "ordinal": { "$ref": "#/$defs/count" },
        "input_sha256": { "$ref": "#/$defs/digest" }, "common_sha256": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["missing", "ineligible", "eligible"] }, "reasons": { "type": "array", "items": { "type": "string" } },
        "quality_probes": { "type": "array", "items": { "$ref": "#/$defs/quality_probe" } }
      }
    }
  }
}
