{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lorelum benchmark suite",
  "type": "object",
  "required": ["id", "version", "track", "lifecycle_stage", "conditions", "tasks"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string" },
    "track": { "enum": ["practice-effectiveness", "performance-skill-comparison"] },
    "lifecycle_stage": { "enum": ["candidate", "pilot", "frozen", "official", "published", "retired"] },
    "conditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "lifecycle_stage"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+-v[1-9][0-9]*$" },
          "path": { "type": "string", "pattern": "^tasks/[a-z0-9-]+/v[1-9][0-9]*$" },
          "lifecycle_stage": { "enum": ["candidate", "pilot", "frozen", "official", "published", "retired"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
