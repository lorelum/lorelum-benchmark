{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "async-report-timing-pilot-preflight-v1.schema.json",
  "title": "Async report timing pilot preflight summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "status",
    "execution_mode",
    "allowed_to_start",
    "judge_score_usable",
    "plan_hash",
    "model",
    "evaluator",
    "runner",
    "agent",
    "environment",
    "budget",
    "cost_estimate",
    "judge",
    "gates",
    "runtime",
    "preflight_duration_ms",
    "pi_probe"
  ],
  "properties": {
    "schema_version": {
      "const": "async-report-timing-pilot-preflight/v1"
    },
    "status": {
      "enum": [
        "ready",
        "preflight-blocked",
        "invalid-plan"
      ]
    },
    "allowed_to_start": {
      "type": "boolean"
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "snapshot_id"
      ],
      "properties": {
        "id": {
          "const": "async-report-deterministic-evaluator"
        },
        "version": {
          "const": "v1"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "command",
        "observed_version",
        "command_sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "observed_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "command_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "bun",
        "node",
        "manifest_sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "bun": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_turns",
        "max_duration_ms"
      ],
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "max_duration_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cost_estimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_attempts",
        "judge_calibration_calls",
        "judge_scoring_calls",
        "agent_max_duration_ms",
        "total_judge_calls",
        "cost_usd",
        "preflight_cost_usd"
      ],
      "properties": {
        "agent_attempts": {
          "const": 9
        },
        "judge_calibration_calls": {
          "const": 9
        },
        "judge_scoring_calls": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "const": 9
            }
          ]
        },
        "agent_max_duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "total_judge_calls": {
          "anyOf": [
            {
              "const": 9
            },
            {
              "const": 18
            }
          ]
        },
        "cost_usd": {
          "const": "unavailable"
        },
        "preflight_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "model",
        "real_opt_in",
        "calibration_hash",
        "calibration_reused",
        "calibration_status",
        "calibration_calls",
        "calibration_duration_ms",
        "calibration_usage"
      ],
      "properties": {
        "provider_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "real_opt_in": {
          "type": "boolean"
        },
        "calibration_status": {
          "enum": [
            "qualified",
            "diagnostic",
            "not-run",
            "unavailable"
          ]
        },
        "calibration_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "calibration_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "calibration_usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens",
            "total_tokens",
            "cost_usd"
          ],
          "properties": {
            "input_tokens": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "output_tokens": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "total_tokens": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "cost_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "calibration_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "calibration_reused": {
          "type": "boolean"
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not-run",
              "accepted-diagnostic"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "failure_reason": {
      "type": "string"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_bun",
        "observed_node"
      ],
      "properties": {
        "observed_bun": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_node": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "manifest_sha256"
      ],
      "properties": {
        "id": {
          "const": "async-report-timing-pilot-runner"
        },
        "version": {
          "const": "v1"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "preflight_duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "pi_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls",
        "duration_ms",
        "usage"
      ],
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens",
            "total_tokens",
            "cost_usd"
          ],
          "properties": {
            "input_tokens": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "output_tokens": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "total_tokens": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "cost_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "execution_mode": {
      "enum": [
        "judge-scored",
        "diagnostic-only"
      ]
    },
    "judge_score_usable": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "diagnostic-only"
          }
        }
      },
      "then": {
        "properties": {
          "judge_score_usable": {
            "const": false
          },
          "cost_estimate": {
            "properties": {
              "judge_scoring_calls": {
                "const": 0,
                "type": "integer"
              },
              "total_judge_calls": {
                "const": 9,
                "type": "integer"
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "judge-scored"
          },
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "judge_score_usable": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "judge-scored"
          }
        }
      },
      "then": {
        "properties": {
          "cost_estimate": {
            "properties": {
              "judge_scoring_calls": {
                "const": 9,
                "type": "integer"
              },
              "total_judge_calls": {
                "const": 18,
                "type": "integer"
              }
            },
            "type": "object"
          }
        }
      }
    }
  ]
}
