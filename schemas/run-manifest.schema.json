{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lorelum benchmark immutable run manifest",
  "type": "object",
  "required": ["run_id", "experiment_id", "experiment_plan_hash", "run_kind", "source_commit", "adapter_commit", "suite", "task", "treatment", "environment", "scorer", "agent", "execution", "inputs", "artifacts"],
  "properties": {
    "run_id": { "type": "string" },
    "experiment_id": { "type": "string", "minLength": 1 },
    "experiment_plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "run_kind": { "enum": ["smoke", "official"] },
    "source_commit": { "type": "string", "minLength": 1 },
    "adapter_commit": { "type": "string", "minLength": 1 },
    "suite": { "type": "object", "required": ["id", "version"] },
    "task": { "type": "object", "required": ["id", "revision", "snapshot_id"] },
    "treatment": { "type": "object", "required": ["id", "version"] },
    "environment": { "type": "object", "required": ["id", "version"] },
    "scorer": { "type": "object", "required": ["id", "version"] },
    "agent": { "type": "object", "required": ["id", "version", "model", "model_version", "system_prompt_hash"] },
    "execution": { "type": "object", "required": ["seed", "budget", "tool_policy_hash"] },
    "inputs": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "artifacts": { "type": "array", "items": { "$ref": "artifact.schema.json" } }
  },
  "additionalProperties": false
}
