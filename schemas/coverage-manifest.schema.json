{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lorelum benchmark coverage manifest",
  "type": "object",
  "required": ["version", "baseline", "coverage_status", "covered_rules", "acceptance"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "baseline": { "type": "object", "required": ["repository", "revision", "skill"] },
    "coverage_status": { "enum": ["partial", "complete"] },
    "covered_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tasks"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9-]+-v[1-9][0-9]*$" }
          }
        },
        "additionalProperties": true
      }
    },
    "acceptance": { "type": "object" }
  },
  "additionalProperties": true
}
