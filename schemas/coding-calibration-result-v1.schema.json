{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding-calibration-result-v1.schema.json",
  "title": "Coding calibration result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "evaluator_sha256", "calibration_sha256", "image_id", "passed", "results"],
  "properties": {
    "schema_version": { "const": "coding-calibration-result/v1" },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" },
    "evaluator_sha256": { "$ref": "#/$defs/digest" },
    "calibration_sha256": { "$ref": "#/$defs/digest" },
    "image_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "passed": { "type": "boolean" },
    "results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["workspace", "expected", "observed", "health", "matches"],
        "properties": {
          "workspace": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" },
          "expected": { "enum": ["pass", "fail", "not-run"] },
          "observed": { "enum": ["pass", "fail", "not-run"] },
          "health": { "enum": ["evaluated", "execution-failed", "indeterminate"] },
          "matches": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
