{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "async-report-replan-judge-accounting-v1.schema.json",
  "title": "Async-report replan Judge accounting v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "accounting_version", "state", "blind_case_id", "plan", "evidence", "rubric", "prompt_hash", "input_hash", "provider", "calibration", "calls", "duration_ms", "usage"],
  "properties": {
    "schema_version": { "const": "async-report-replan-judge-accounting/v1" },
    "accounting_version": { "const": 1 },
    "state": { "enum": ["observed", "indeterminate", "judge-unavailable", "not-run"] },
    "blind_case_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "hash"],
      "properties": {
        "schema_version": { "const": "replan-evidence/v1" },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "prompt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "model"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"] }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "hash", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "status": { "enum": ["qualified", "diagnostic", "not-run"] }
      }
    },
    "calls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibration", "scoring"],
      "properties": {
        "calibration": { "type": "integer", "minimum": 0, "maximum": 9 },
        "scoring": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "cost_usd"],
      "properties": {
        "input_tokens": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "const": "unavailable" }] },
        "output_tokens": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "const": "unavailable" }] },
        "total_tokens": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "const": "unavailable" }] },
        "cost_usd": { "anyOf": [{ "type": "number", "minimum": 0 }, { "const": "unavailable" }] }
      }
    },
    "failure_reason": { "type": "string", "minLength": 1 }
  }
}
