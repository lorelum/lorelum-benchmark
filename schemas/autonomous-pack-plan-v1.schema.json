{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autonomous-pack-plan-v1.schema.json",
  "title": "Autonomous Pack experiment plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "run_kind", "tasks", "repetitions", "order_seed", "common", "pack"],
  "properties": {
    "schema_version": { "const": "autonomous-pack-plan/v1" },
    "id": { "type": "string", "minLength": 1 },
    "run_kind": { "enum": ["pilot", "official"] },
    "tasks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source_sha256", "input_sha256", "evaluator_sha256"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source_sha256": { "$ref": "#/$defs/digest" },
          "input_sha256": { "$ref": "#/$defs/digest" },
          "evaluator_sha256": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "repetitions": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "order_seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "common": {
      "type": "object", "additionalProperties": false,
      "required": ["environment_sha256", "image_sha256", "agent", "model", "model_parameters_sha256", "profile_sha256", "tool_policy_sha256", "system_prompt_sha256", "budget"],
      "properties": {
        "environment_sha256": { "$ref": "#/$defs/digest" },
        "image_sha256": { "$ref": "#/$defs/digest" },
        "agent": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "model_parameters_sha256": { "$ref": "#/$defs/digest" },
        "profile_sha256": { "$ref": "#/$defs/digest" },
        "tool_policy_sha256": { "$ref": "#/$defs/digest" },
        "system_prompt_sha256": { "$ref": "#/$defs/digest" },
        "budget": {
          "type": "object", "additionalProperties": false,
          "required": ["max_turns", "max_duration_ms"],
          "properties": {
            "max_turns": { "type": "integer", "minimum": 1 },
            "max_duration_ms": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "pack": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "snapshot_uri", "snapshot_sha256", "index_sha256"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "snapshot_uri": { "type": "string", "minLength": 1 },
        "snapshot_sha256": { "$ref": "#/$defs/digest" },
        "index_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
