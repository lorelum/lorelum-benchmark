{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lorelum benchmark run record",
  "type": "object",
  "required": [
    "run_id",
    "experiment_id",
    "experiment_plan_hash",
    "run_kind",
    "condition_id",
    "repeat",
    "suite_version",
    "task_id",
    "task_version",
    "evaluator_version",
    "source_commit",
    "adapter_commit",
    "snapshot_id",
    "adapter",
    "treatment",
    "environment",
    "run_manifest",
    "track",
    "condition",
    "model",
    "started_at",
    "outcome"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "experiment_id": { "type": "string", "minLength": 1 },
    "experiment_plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "run_kind": { "enum": ["smoke", "pilot", "official"] },
    "condition_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "repeat": { "type": "integer", "minimum": 1 },
    "suite_version": { "type": "string" },
    "task_id": { "type": "string" },
    "task_version": { "type": "integer", "minimum": 1 },
    "evaluator_version": { "type": "integer", "minimum": 1 },
    "track": {
      "enum": ["practice-effectiveness", "performance-skill-comparison"]
    },
    "condition": {
      "enum": [
        "baseline",
        "oracle-practice",
        "lorelum-retrieval",
        "irrelevant-practice",
        "vercel-skill"
      ]
    },
    "model": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object" }
      }
    },
    "source_commit": { "type": "string", "minLength": 1 },
    "adapter_commit": { "type": "string", "minLength": 1 },
    "snapshot_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "adapter": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "treatment": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "run_manifest": {
      "type": "object",
      "required": ["uri", "sha256"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "started_at": { "type": "string", "format": "date-time" },
    "retrieval": {
      "type": "object",
      "properties": {
        "query_count": { "type": "integer", "minimum": 0 },
        "practice_ids": { "type": "array", "items": { "type": "string" } },
        "injected_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "cost": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["automated_checks_passed"],
      "properties": {
        "automated_checks_passed": { "type": "boolean" },
        "blind_review": { "enum": ["pass", "partial", "fail", "pending"] },
        "diff_path": { "type": "string" },
        "failure_reason": { "type": "string", "minLength": 1 },
        "quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "evaluator": {
          "type": "object",
          "required": ["schema_version", "evaluator_version", "semantic", "quality"],
          "properties": {
            "schema_version": { "const": "evaluator-result/v2" },
            "evaluator_version": { "const": 2 },
            "semantic": {
              "type": "object",
              "required": ["passed", "checks"],
              "properties": {
                "passed": { "type": "boolean" },
                "checks": { "type": "array" }
              },
              "additionalProperties": false
            },
            "quality": {
              "type": "object",
              "required": ["score", "probes"],
              "properties": {
                "score": { "type": "integer", "minimum": 0, "maximum": 100 },
                "probes": { "type": "array" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
