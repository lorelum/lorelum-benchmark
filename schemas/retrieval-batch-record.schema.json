{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lorelum retrieval-ranking batch record",
  "type": "object",
  "required": [
    "schema_version",
    "track",
    "run_id",
    "batch_status",
    "started_at",
    "finished_at",
    "benchmark",
    "corpus",
    "lorelum",
    "embedding",
    "retrieval",
    "environment",
    "result_artifact",
    "execution",
    "outcome"
  ],
  "properties": {
    "schema_version": { "const": "retrieval-batch-record/v1" },
    "track": { "const": "retrieval-ranking" },
    "run_id": { "type": "string", "minLength": 1 },
    "batch_status": { "enum": ["complete", "failed"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "benchmark": {
      "type": "object",
      "required": [
        "suiteId",
        "suiteVersion",
        "revision",
        "casesSha256",
        "labelsSha256",
        "scorerSha256"
      ],
      "properties": {
        "suiteId": { "const": "retrieval-ranking" },
        "suiteVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "revision": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
        "casesSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "labelsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "scorerSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "corpus": {
      "type": "object",
      "required": ["source_repository", "snapshot_commit", "corpus_digest", "practice_count", "pack_artifacts"],
      "properties": {
        "source_repository": { "type": "string", "minLength": 1 },
        "snapshot_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "corpus_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "practice_count": { "type": "integer", "minimum": 1 },
        "pack_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "releaseVersion", "sourceCommit", "artifactDigest", "practiceIds"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "releaseVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
              "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
              "artifactDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "practiceIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "lorelum": {
      "type": "object",
      "required": ["repository", "commit", "protocol_version", "entrypoint"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "protocol_version": { "const": 1 },
        "entrypoint": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "embedding": {
      "type": "object",
      "required": ["profile_id", "model"],
      "properties": {
        "profile_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "model": {
          "type": "object",
          "required": ["id", "version", "nativeRuntime"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "nativeRuntime": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "retrieval": {
      "type": "object",
      "required": ["candidate_width", "result_limit"],
      "properties": {
        "candidate_width": { "type": "integer", "minimum": 1, "maximum": 50 },
        "result_limit": { "type": "integer", "minimum": 1, "maximum": 50 }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["platform", "arch", "bunVersion"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "bunVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "result_artifact": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["case_count", "successful_case_count", "failure_count", "failures"],
      "properties": {
        "case_count": { "type": "integer", "minimum": 1 },
        "successful_case_count": { "type": "integer", "minimum": 0 },
        "failure_count": { "type": "integer", "minimum": 0 },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case_id", "kind", "error_code"],
            "properties": {
              "case_id": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["harness-error", "process-error", "protocol-error"] },
              "error_code": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["retrieval_scored"],
      "properties": {
        "retrieval_scored": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
