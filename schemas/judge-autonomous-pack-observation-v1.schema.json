{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "judge-autonomous-pack-observation-v1.schema.json",
  "title": "Interactive Judge Pack diagnostic observation v1",
  "type": "object",
  "required": ["schema", "ordinal", "condition", "judgeStatus"],
  "properties": {
    "schema": { "const": "judge-autonomous-pack-observation/v1" },
    "ordinal": { "type": "integer", "minimum": 0, "maximum": 1 },
    "condition": { "enum": ["empty-store", "pack-installed"] },
    "judgeStatus": { "enum": ["completed", "failed", "cancelled", "timed_out", "declined", "not-run"] },
    "decisionSource": { "const": "terminal-input-unverified" },
    "judgeCandidateIdentity": { "anyOf": [{ "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, { "type": "null" }] },
    "candidateSha256": { "anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
    "delivery": { "enum": ["approved", "declined", "not-requested"] },
    "semantic": {
      "type": "object",
      "required": ["health", "semantic", "quality", "failure_reasons"],
      "properties": {
        "health": { "enum": ["evaluated", "execution-failed", "invalid-output", "not-executable", "indeterminate"] },
        "semantic": { "enum": ["pass", "fail", "not-run"] },
        "quality": { "enum": ["observed", "not-observed", "indeterminate", "not-run", "judge-unavailable"] },
        "quality_probes": { "type": "array" },
        "failure_reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "retrieval": {
      "type": "object", "additionalProperties": false, "required": ["coverage", "reason", "events"],
      "properties": {
        "coverage": { "const": "indeterminate" },
        "reason": { "type": "string", "minLength": 1 },
        "events": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["operation", "request", "status", "resultCount", "errorCode"],
            "properties": {
              "operation": { "enum": ["query", "get", "unknown"] },
              "request": { "type": ["string", "null"] },
              "status": { "enum": ["success", "empty", "not-found", "failed", "indeterminate"] },
              "resultCount": { "type": ["integer", "null"], "minimum": 0 },
              "errorCode": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "quality": { "const": "not-run" },
    "costUsd": { "type": "null" },
    "modelUsage": { "type": ["array", "null"], "items": { "type": ["object", "null"] } },
    "elapsedMs": { "type": "integer", "minimum": 0 },
    "reason": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "judgeStatus": { "const": "not-run" } }, "required": ["judgeStatus"] },
      "then": { "required": ["reason"] },
      "else": { "required": ["decisionSource", "judgeCandidateIdentity", "candidateSha256", "delivery", "semantic", "retrieval", "quality", "costUsd", "modelUsage", "elapsedMs"] } },
    { "if": { "properties": { "judgeStatus": { "const": "completed" } }, "required": ["judgeStatus"] },
      "then": { "properties": { "judgeCandidateIdentity": { "type": "string" }, "candidateSha256": { "type": "string" } } },
      "else": { "properties": { "judgeCandidateIdentity": { "type": "null" }, "candidateSha256": { "type": "null" }, "delivery": { "const": "not-requested" }, "semantic": { "type": "object", "properties": { "semantic": { "const": "not-run" } } } } } },
    { "if": { "properties": { "semantic": { "type": "object", "properties": { "health": { "not": { "const": "evaluated" } } }, "required": ["health"] } }, "required": ["semantic"] },
      "then": { "properties": { "semantic": { "type": "object", "properties": { "semantic": { "const": "not-run" } } } } },
      "else": { "properties": { "semantic": { "type": "object", "properties": { "semantic": { "enum": ["pass", "fail"] } } } } } }
  ]
}
