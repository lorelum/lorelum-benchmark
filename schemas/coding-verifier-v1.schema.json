{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding-verifier-v1.schema.json",
  "title": "Coding verifier contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "driver", "candidate", "timeout_ms"],
  "properties": {
    "schema_version": { "const": "coding-verifier/v1" },
    "driver": { "$ref": "#/$defs/driverCommand" },
    "candidate": { "$ref": "#/$defs/candidateCommand" },
    "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 300000 }
  },
  "$defs": {
    "driverCommand": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{ "type": "string", "pattern": "^/[^\\u0000]*$" }, { "type": "string", "pattern": "^/verifier/.+" }],
      "items": false
    },
    "candidateCommand": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{ "type": "string", "pattern": "^/[^\\u0000]*$" }, { "type": "string", "pattern": "^/workspace/.+" }],
      "items": false
    }
  }
}
