{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding-calibration-v1.schema.json",
  "title": "Private coding task calibration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspaces"],
  "properties": {
    "schema_version": { "const": "coding-calibration/v1" },
    "workspaces": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "expected_semantic", "purpose"],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" },
          "expected_semantic": { "enum": ["pass", "fail", "not-run"] },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
