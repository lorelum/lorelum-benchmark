{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "async-report-timing-pilot-run-v1.schema.json",
  "title": "Async report timing pilot scratch run result v1",
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cost_usd"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "total_tokens": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "block",
        "position",
        "repetition",
        "condition_id",
        "delivery_node"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^block-[1-3]-position-[1-3]-[a-z0-9-]+$"
        },
        "block": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "repetition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "condition_id": {
          "enum": [
            "task_start",
            "constraint_followup",
            "first_implementation_checkpoint"
          ]
        },
        "delivery_node": {
          "enum": [
            "task_start",
            "constraint_followup",
            "first_implementation_checkpoint"
          ]
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "attempt_id",
        "master_plan_hash",
        "delivery_plan_hash",
        "slot",
        "execution_mode",
        "status",
        "execution",
        "delivery",
        "evaluator",
        "judge",
        "cost",
        "artifacts"
      ],
      "properties": {
        "schema_version": {
          "const": "async-report-timing-pilot-attempt/v1"
        },
        "attempt_id": {
          "type": "string"
        },
        "master_plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "delivery_plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "slot": {
          "$ref": "#/$defs/slot"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "indeterminate",
            "blocked",
            "not-run"
          ]
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "duration_ms",
            "turns",
            "usage"
          ],
          "properties": {
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "turns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 128
            },
            "usage": {
              "$ref": "#/$defs/usage"
            },
            "termination_reason": {
              "type": "string",
              "maxLength": 240
            }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "session_binding",
            "comparable"
          ],
          "properties": {
            "status": {
              "enum": [
                "delivered",
                "not-declared",
                "unsupported",
                "failed",
                "indeterminate",
                "invalid-plan",
                "blocked",
                "not-run",
                "not-started"
              ]
            },
            "session_binding": {
              "enum": [
                "same-session",
                "not-started",
                "resume-failed"
              ]
            },
            "comparable": {
              "type": "boolean"
            }
          }
        },
        "evaluator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "status",
            "duration_ms",
            "check_ids"
          ],
          "properties": {
            "id": {
              "const": "async-report-deterministic-evaluator"
            },
            "version": {
              "const": "v1"
            },
            "status": {
              "enum": [
                "pass",
                "fail",
                "indeterminate"
              ]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "check_ids": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "lifecycle-queued-processing-completed",
                  "lifecycle-failure-and-retry",
                  "progress-persistence",
                  "pause-at-checkpoint",
                  "resume-preserves-progress",
                  "v1-v2-overlap-preserves-safe-state",
                  "rollback-preserves-extension-fields",
                  "unsafe-state-preserved-and-rejected",
                  "concurrent-workers-serialize-progress"
                ]
              }
            }
          }
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "score_usable",
            "score",
            "confidence",
            "provider_id",
            "provider_version",
            "model",
            "plan_hash",
            "rubric_hash",
            "prompt_hash",
            "input_hash",
            "evidence_hash",
            "duration_ms",
            "usage",
            "calls"
          ],
          "properties": {
            "state": {
              "enum": [
                "observed",
                "indeterminate",
                "judge-unavailable",
                "not-run"
              ]
            },
            "score": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "confidence": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "provider_id": {
              "const": "judge-agent/async-report-replan/v1"
            },
            "provider_version": {
              "const": "v1"
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "plan_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "rubric_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "prompt_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "input_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "evidence_hash": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "usage": {
              "$ref": "#/$defs/usage"
            },
            "calls": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "calibration",
                "scoring"
              ],
              "properties": {
                "calibration": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9
                },
                "scoring": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "failure_reason": {
              "type": "string",
              "maxLength": 240
            },
            "score_usable": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "state": {
                    "const": "observed"
                  }
                }
              },
              "then": {
                "properties": {
                  "score": {
                    "type": "integer"
                  },
                  "confidence": {
                    "type": "integer"
                  }
                }
              }
            }
          ]
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent_cost_usd",
            "judge_cost_usd",
            "total_cost_usd"
          ],
          "properties": {
            "agent_cost_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "judge_cost_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "total_cost_usd": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attempt_root",
            "delivery_summary",
            "public_trace"
          ],
          "properties": {
            "attempt_root": {
              "type": "string",
              "pattern": "^scratch/"
            },
            "delivery_summary": {
              "type": "string",
              "pattern": "^(?:|scratch/)"
            },
            "public_trace": {
              "type": "string",
              "pattern": "^(?:|scratch/)"
            }
          }
        },
        "execution_mode": {
          "enum": [
            "judge-scored",
            "diagnostic-only"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_mode": {
                "const": "diagnostic-only"
              }
            }
          },
          "then": {
            "properties": {
              "judge": {
                "properties": {
                  "score_usable": {
                    "const": false
                  },
                  "state": {
                    "const": "not-run"
                  },
                  "score": {
                    "type": "null"
                  },
                  "confidence": {
                    "type": "null"
                  },
                  "calls": {
                    "properties": {
                      "calibration": {
                        "const": 0
                      },
                      "scoring": {
                        "const": 0
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "master_plan_hash",
    "execution_mode",
    "judge_score_usable",
    "planned_slots",
    "attempted_slots",
    "attempts",
    "cost_ledger",
    "output_root",
    "formal_record_created"
  ],
  "properties": {
    "schema_version": {
      "const": "async-report-timing-pilot-run/v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "status": {
      "enum": [
        "ready",
        "preflight-blocked",
        "invalid-plan",
        "completed",
        "incomplete"
      ]
    },
    "master_plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "planned_slots": {
      "const": 9
    },
    "attempted_slots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "attempts": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "cost_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "judge",
        "calibration",
        "agent_cost_usd",
        "judge_cost_usd",
        "total_cost_usd"
      ],
      "properties": {
        "agent": {
          "$ref": "#/$defs/usage"
        },
        "judge": {
          "$ref": "#/$defs/usage"
        },
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "calls",
            "duration_ms",
            "usage"
          ],
          "properties": {
            "status": {
              "enum": [
                "qualified",
                "diagnostic",
                "not-run"
              ]
            },
            "calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "usage": {
              "$ref": "#/$defs/usage"
            }
          }
        },
        "agent_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "judge_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "total_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "output_root": {
      "type": "string",
      "pattern": "^scratch/"
    },
    "formal_record_created": {
      "const": false
    },
    "execution_mode": {
      "enum": [
        "judge-scored",
        "diagnostic-only"
      ]
    },
    "judge_score_usable": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "diagnostic-only"
          }
        }
      },
      "then": {
        "properties": {
          "judge_score_usable": {
            "const": false
          },
          "attempts": {
            "items": {
              "type": "object",
              "properties": {
                "execution_mode": {
                  "const": "diagnostic-only"
                }
              }
            },
            "type": "array"
          }
        }
      }
    }
  ]
}
