{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lorelum retrieval-ranking scorer configuration",
  "type": "object",
  "required": ["schemaVersion", "revision", "candidateWidth", "resultLimit", "metrics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
    "candidateWidth": { "type": "integer", "minimum": 1, "maximum": 50 },
    "resultLimit": { "type": "integer", "minimum": 1, "maximum": 50 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
