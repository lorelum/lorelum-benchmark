{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding-task-v1.schema.json",
  "title": "Reusable coding task declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "lifecycle_stage", "public", "environment", "verifier", "calibration"],
  "properties": {
    "schema_version": { "const": "coding-task/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" },
    "lifecycle_stage": { "const": "candidate" },
    "public": {
      "type": "object", "additionalProperties": false, "required": ["task", "starter"],
      "properties": { "task": { "const": "public/task.md" }, "starter": { "const": "public/starter" } }
    },
    "environment": {
      "type": "object", "additionalProperties": false, "required": ["runtime"],
      "properties": { "runtime": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$" } }
    },
    "verifier": {
      "type": "object", "additionalProperties": false, "required": ["root", "contract"],
      "properties": { "root": { "const": "private/evaluator" }, "contract": { "const": "private/evaluator/contract.json" } }
    },
    "calibration": {
      "type": "object", "additionalProperties": false, "required": ["root"],
      "properties": { "root": { "const": "private/calibration" } }
    }
  }
}
