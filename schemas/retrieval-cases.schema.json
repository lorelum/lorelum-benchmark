{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lorelum retrieval-ranking query cases",
  "type": "object",
  "required": ["schemaVersion", "revision", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "revision": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
    "cases": {
      "type": "array",
      "minItems": 30,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "query"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "query": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
