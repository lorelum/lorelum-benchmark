{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lorelum benchmark experiment plan",
  "type": "object",
  "required": ["id", "version", "source_commit", "suite", "conditions", "smoke_tasks", "full_tasks", "environment", "agent", "model", "repetitions", "seed", "budget", "system_prompt_path", "system_prompt_hash", "tool_policy_hash"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
    "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "suite": { "type": "object", "required": ["id", "version"] },
    "conditions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "label", "treatment"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "treatment": { "type": "string", "pattern": "^[a-z0-9-]+/v[1-9][0-9]*$" }
        },
        "additionalProperties": false
      }
    },
    "smoke_tasks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "full_tasks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "environment": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": ["id", "version", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "model": { "type": "object", "required": ["id", "version"] },
    "repetitions": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "budget": { "type": "object", "required": ["max_turns", "max_duration_ms"] },
    "system_prompt_path": { "type": "string", "minLength": 1 },
    "system_prompt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tool_policy_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "analysis": { "type": "object" }
  },
  "additionalProperties": false
}
