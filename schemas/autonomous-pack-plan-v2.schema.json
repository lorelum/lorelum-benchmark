{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autonomous-pack-plan-v2.schema.json",
  "title": "Reusable autonomous Pack plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_contract", "plan", "task_contracts"],
  "properties": {
    "schema_version": { "const": "autonomous-pack-plan/v2" },
    "execution_contract": { "const": "autonomous-pack-pi-verifier/v2" },
    "plan": { "$ref": "autonomous-pack-plan-v1.schema.json" },
    "task_contracts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "runtime", "declaration_sha256", "calibration_sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" },
          "runtime": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$" },
          "declaration_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "calibration_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
