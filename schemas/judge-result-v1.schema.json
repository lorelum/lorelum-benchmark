{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lorelum JudgeAgent result v1 (sidecar)",
  "$comment": "Independent soft-quality sidecar. Never extends evaluator-result/v2. Sum-of-points invariants are enforced by assertJudgeResultV1 because JSON Schema cannot express them.",
  "type": "object",
  "required": ["schema_version", "judge_version", "judge", "state", "prompt_hash", "rubric_hash", "input_hash", "confidence"],
  "properties": {
    "schema_version": { "const": "judge-result/v1" },
    "judge_version": { "const": 1 },
    "judge": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "state": {
      "enum": ["observed", "not-observed", "indeterminate", "not-run", "judge-unavailable"]
    },
    "score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "points", "max_points", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "points": { "type": "integer", "minimum": 0, "maximum": 100 },
          "max_points": { "type": "integer", "minimum": 1, "maximum": 100 },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "prompt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rubric_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
    "reason": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "state": { "const": "observed" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "criteria": { "type": "array", "minItems": 1 },
          "reason": false
        },
        "required": ["score", "criteria"]
      },
      "else": {
        "properties": {
          "score": { "const": 0 },
          "criteria": { "type": "array", "maxItems": 0 }
        },
        "required": ["score", "criteria"]
      }
    },
    {
      "if": {
        "anyOf": [
          { "properties": { "state": { "const": "indeterminate" } }, "required": ["state"] },
          { "properties": { "state": { "const": "judge-unavailable" } }, "required": ["state"] }
        ]
      },
      "then": {
        "properties": { "reason": { "type": "string", "minLength": 1 } },
        "required": ["reason"]
      }
    }
  ],
  "additionalProperties": false
}
