{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lorelum Pi run request v2",
  "type": "object",
  "required": ["schema_version", "run_id", "source_commit", "candidate_path", "suite", "task", "treatment", "environment", "scorer", "agent", "execution", "inputs", "artifacts"],
  "properties": {
    "schema_version": { "const": "pi-run/v2" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "candidate_path": { "type": "string", "minLength": 1 },
    "suite": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["id", "revision", "snapshot_id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+-v[1-9][0-9]*$" },
        "revision": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
        "snapshot_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "treatment": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" }
      },
      "additionalProperties": false
    },
    "scorer": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "required": ["id", "version", "model", "system_prompt_hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "system_prompt_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["command", "args", "seed", "budget", "tool_policy_hash"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "seed": { "type": "integer", "minimum": 0 },
        "budget": {
          "type": "object",
          "required": ["max_turns", "max_duration_ms"],
          "properties": {
            "max_turns": { "type": "integer", "minimum": 1 },
            "max_duration_ms": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "tool_policy_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "inputs": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
    "artifacts": {
      "type": "object",
      "required": ["manifest_name"],
      "properties": {
        "manifest_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
